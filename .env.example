# Database
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/review-pilot?sslmode=require
ENABLE_GOOGLE_PLACES_AUDIT=false
ENABLE_TRUSTPILOT_AUDIT=false
ENABLE_EXTERNAL_REVIEW_WIDGET=false
# À passer à true seulement après validation de l'accès API Google Business
# Profile et vérification du parcours de consentement en production.
ENABLE_GOOGLE_REVIEW_AUTOMATION=false
# Contrôle commercial séparé : n'activer qu'après capacité humaine, SLA et
# prix/cap mensuel contractuels pour les avis 1-3 étoiles.
ENABLE_CAELA_HUMAN_DELEGATION=false
# À passer à true seulement avec une licence/API Trustpilot autorisant cet usage.
ENABLE_TRUSTPILOT_INTEGRATION=false
REVIEW_TEAM_EMAIL=avis@caela.fr

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Resend
RESEND_API_KEY=re_...

# Cron security
CRON_SECRET=your-cron-secret-key

# App URL
NEXT_PUBLIC_APP_URL=https://review-pilot.vercel.app

# Chiffrement des jetons OAuth Google / clés API Trustpilot stockés en base
# (businesses.platform_token). Clé 32 octets à générer UNE FOIS et régler sur
# Vercel — ne jamais committer la vraie valeur : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
